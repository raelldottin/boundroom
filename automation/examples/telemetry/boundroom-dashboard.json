{
  "uid": "boundroom-overview",
  "title": "Boundroom",
  "description": "Boundroom's metric catalogue (SPEC-006) on a Prometheus-compatible backend that receives OTLP. Each run is its own series, so panels sum each series' last value with last_over_time, not rate() (automation/examples/telemetry/README.md).",
  "tags": [
    "boundroom"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "timezone": "utc",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job (service.name)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(boundroom_runs_total, job)",
          "refId": "job"
        },
        "definition": "label_values(boundroom_runs_total, job)",
        "current": {
          "text": "boundroom",
          "value": "boundroom"
        },
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "hide": 0,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Runs",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Runs",
      "description": "Runs of every entry point in the time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(last_over_time(boundroom_runs_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "runs",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Runs that didn't exit 0",
      "description": "Runs whose process failed, was refused or raised. A slice verdict such as stop_failed still exits 0: see Slices.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(last_over_time(boundroom_runs_total{job=~\"$job\",outcome=~\"failed|refused|error\"}[$__range]))",
          "legendFormat": "not ok",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Runs by entry and outcome",
      "description": "boundroom.runs, summed per entry point and outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (entry, outcome) (last_over_time(boundroom_runs_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "{{entry}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Run duration by entry",
      "description": "The median and 95th percentile of boundroom.run.duration, from its histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, entry) (last_over_time(boundroom_run_duration_seconds_bucket{job=~\"$job\"}[$__range])))",
          "legendFormat": "{{entry}} p50",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, entry) (last_over_time(boundroom_run_duration_seconds_bucket{job=~\"$job\"}[$__range])))",
          "legendFormat": "{{entry}} p95",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Runs over time",
      "description": "Runs per interval, by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (last_over_time(boundroom_runs_total{job=~\"$job\"}[$__interval]))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Slices",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Slice verdicts",
      "description": "boundroom.slice.decisions by decision. accept and reject come from evaluate_handoff.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (decision) (last_over_time(boundroom_slice_decisions_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "{{decision}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Queue status written",
      "description": "The queue status the supervisor wrote with each verdict.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (queue_status) (last_over_time(boundroom_slice_decisions_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "{{queue_status}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Agent sessions",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Sessions by runner and outcome",
      "description": "Agent sessions, counted from the boundroom.agent_session.duration histogram. The runner is the one asked for; auto stays auto.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (runner, outcome) (last_over_time(boundroom_agent_session_duration_seconds_count{job=~\"$job\"}[$__range]))",
          "legendFormat": "{{runner}} {{outcome}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Session duration by runner",
      "description": "The median and 95th percentile of an agent session, from its histogram buckets.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, runner) (last_over_time(boundroom_agent_session_duration_seconds_bucket{job=~\"$job\"}[$__range])))",
          "legendFormat": "{{runner}} p50",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, runner) (last_over_time(boundroom_agent_session_duration_seconds_bucket{job=~\"$job\"}[$__range])))",
          "legendFormat": "{{runner}} p95",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Average session",
      "description": "Total session time over the number of sessions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(last_over_time(boundroom_agent_session_duration_seconds_sum{job=~\"$job\"}[$__range])) / sum(last_over_time(boundroom_agent_session_duration_seconds_count{job=~\"$job\"}[$__range]))",
          "legendFormat": "average",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Validation and sync",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "bargauge",
      "title": "Validation replays by result",
      "description": "Validation commands the supervisor replayed, by entry point and whether they passed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (entry, success) (last_over_time(boundroom_validation_replays_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "{{entry}} success={{success}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 16,
      "type": "bargauge",
      "title": "Files synced and removed",
      "description": "boundroom.sync.changes: files the sync tool wrote into a consumer or removed from it.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (last_over_time(boundroom_sync_changes_total{job=~\"$job\"}[$__range]))",
          "legendFormat": "{{kind}}",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Sync runs refused",
      "description": "Syncs the tool refused, such as an unpinned or dirty source, or a locally modified file.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(last_over_time(boundroom_runs_total{job=~\"$job\",entry=\"sync\",outcome=\"refused\"}[$__range]))",
          "legendFormat": "refused",
          "instant": true,
          "range": false
        }
      ]
    }
  ]
}
